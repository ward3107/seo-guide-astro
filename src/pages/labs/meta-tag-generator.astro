---
import Layout from '../../layouts/Layout.astro';

const base = import.meta.env.BASE_URL;
---

<Layout title="Meta Tag Generator Lab | Waseem's SEO Guide">
  <nav class="breadcrumbs" aria-label="Breadcrumb">
    <ol>
      <li><a href={`${base}/`}>Home</a></li>
      <li><a href={`${base}/labs`}>Labs</a></li>
      <li aria-current="page">Meta Tag Generator</li>
    </ol>
  </nav>

  <header>
    <span class="badge">🏷️ LAB 4</span>
    <h1>Meta Tag Generator</h1>
    <p class="subtitle">Generate a complete, validated set of meta tags: SEO basics + Open Graph (Facebook, LinkedIn, WhatsApp) + Twitter Cards + canonical URL. Live preview of how each platform will render the share.</p>
  </header>

  <section class="lab-tool">
    <div class="form-pane">
      <h3>📝 Page details</h3>

      <label class="input-label" for="pageTitle">Page title</label>
      <input id="pageTitle" type="text" value="How to Optimize INP: A 2026 Field Guide" />

      <label class="input-label" for="pageDesc">Description (155–160 chars)</label>
      <textarea id="pageDesc" rows="3">INP became a Core Web Vital on March 12, 2024. Here are the 7 optimization techniques that moved 12 production sites from "poor" to "good."</textarea>
      <div class="char-bar"><span id="descCount">0</span> / 160 characters</div>

      <label class="input-label" for="pageUrl">Canonical URL</label>
      <input id="pageUrl" type="text" value="https://ward3107.github.io/seo-guide-astro/level2" />

      <label class="input-label" for="pageImage">Share image URL (1200×630 ideal)</label>
      <input id="pageImage" type="text" value="https://ward3107.github.io/seo-guide-astro/og-image.png" />

      <label class="input-label" for="pageType">Page type</label>
      <select id="pageType">
        <option value="website">website</option>
        <option value="article" selected>article</option>
        <option value="product">product</option>
        <option value="profile">profile</option>
        <option value="book">book</option>
        <option value="video">video</option>
      </select>

      <label class="input-label" for="siteName">Site name</label>
      <input id="siteName" type="text" value="Waseem's SEO Guide" />

      <label class="input-label" for="locale">Locale</label>
      <select id="locale">
        <option value="en_US" selected>en_US</option>
        <option value="en_GB">en_GB</option>
        <option value="es_ES">es_ES</option>
        <option value="fr_FR">fr_FR</option>
        <option value="de_DE">de_DE</option>
        <option value="ar_IL">ar_IL</option>
        <option value="he_IL">he_IL</option>
      </select>

      <label class="input-label" for="twitterHandle">Twitter @handle (creator)</label>
      <input id="twitterHandle" type="text" placeholder="@waseem" value="@waseem" />

      <label class="input-label" for="author">Author name</label>
      <input id="author" type="text" value="Waseem" />

      <label class="input-label" for="robots">Robots directive</label>
      <select id="robots">
        <option value="index,follow" selected>index, follow (default)</option>
        <option value="noindex,follow">noindex, follow (hide from search, follow links)</option>
        <option value="index,nofollow">index, nofollow</option>
        <option value="noindex,nofollow">noindex, nofollow (full block)</option>
      </select>
    </div>

    <div class="output-pane">
      <h3>📋 Generated HTML</h3>
      <pre id="output"></pre>
      <div class="actions">
        <button id="copyBtn" type="button" class="btn-primary">📋 Copy</button>
        <button id="downloadBtn" type="button" class="btn-secondary">⬇️ Download .html</button>
      </div>

      <h3 style="margin-top:30px">🔍 Live previews</h3>

      <div class="preview-card facebook">
        <div class="preview-label">📘 Facebook / LinkedIn / WhatsApp</div>
        <div class="card-img" id="fbImg"></div>
        <div class="card-body">
          <div class="card-domain" id="fbDomain">ward3107.github.io</div>
          <div class="card-title" id="fbTitle"></div>
          <div class="card-desc" id="fbDesc"></div>
        </div>
      </div>

      <div class="preview-card twitter">
        <div class="preview-label">🐦 X / Twitter (Large Image Card)</div>
        <div class="card-img" id="twImg"></div>
        <div class="card-body">
          <div class="card-title" id="twTitle"></div>
          <div class="card-desc" id="twDesc"></div>
          <div class="card-domain" id="twDomain"></div>
        </div>
      </div>

      <div class="preview-card slack">
        <div class="preview-label">💬 Slack / Discord (simplified)</div>
        <div class="card-body slack-body">
          <div class="card-site" id="slSite">Waseem's SEO Guide</div>
          <div class="card-title" id="slTitle"></div>
          <div class="card-desc" id="slDesc"></div>
        </div>
      </div>
    </div>
  </section>

  <section class="advice">
    <h2>💡 Why every page needs these</h2>
    <p>Open Graph and Twitter Cards control how your URL looks in <em>every</em> share preview — across Facebook, LinkedIn, WhatsApp, Slack, Discord, iMessage, Telegram, X. A page without them looks broken (no image, blank description) and gets shared less.</p>
    <h3>Image specs that work everywhere</h3>
    <ul>
      <li><strong>1200 × 630 px</strong> (1.91:1 ratio) — works for Facebook, LinkedIn, Twitter summary_large_image, Slack, Discord.</li>
      <li><strong>Under 1 MB</strong>, WebP or PNG preferred.</li>
      <li><strong>Text on image readable at 1/4 size</strong> — LinkedIn shows previews small.</li>
      <li>Test with <a href="https://www.opengraph.xyz" target="_blank" rel="noopener">opengraph.xyz</a> (renders previews for 6+ platforms).</li>
    </ul>
    <h3>Sources</h3>
    <ul>
      <li><a href="https://ogp.me" target="_blank" rel="noopener">ogp.me — Open Graph Protocol spec</a></li>
      <li><a href="https://developer.x.com/en/docs/x-for-websites/cards/overview/markup" target="_blank" rel="noopener">X Cards markup reference</a></li>
    </ul>
  </section>

  <nav class="level-nav">
    <a href={`${base}/labs/robots-txt-simulator`} class="nav-btn">← robots.txt Simulator</a>
    <a href={`${base}/labs/heading-analyzer`} class="nav-btn">Next: Heading Analyzer →</a>
  </nav>
</Layout>

<style>
  .breadcrumbs { margin-bottom: 30px; }
  .breadcrumbs ol { display: flex; list-style: none; padding: 0; margin: 0; gap: 8px; flex-wrap: wrap; }
  .breadcrumbs li { color: var(--color-text-muted); }
  .breadcrumbs li:not(:last-child)::after { content: '→'; margin-left: 8px; color: var(--color-text-muted); }
  .breadcrumbs a { color: var(--color-link); text-decoration: none; }

  header { text-align: center; margin-bottom: 40px; }
  .badge {
    display: inline-block;
    background: linear-gradient(135deg, #11998e 0%, #38ef7d 100%);
    color: white;
    padding: 8px 20px;
    border-radius: 25px;
    font-weight: 600;
    margin-bottom: 20px;
  }
  header h1 { font-size: 2.4em; margin-bottom: 10px; color: var(--color-text); }
  .subtitle { font-size: 1.15em; color: var(--color-text-secondary); max-width: 800px; margin: 0 auto; line-height: 1.6; }

  .lab-tool {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 30px;
    margin: 30px 0;
  }
  @media (max-width: 1000px) { .lab-tool { grid-template-columns: 1fr; } }

  .form-pane, .output-pane {
    background: var(--color-surface-elevated);
    border-radius: 16px;
    padding: 24px;
  }
  .form-pane h3, .output-pane h3 { margin: 0 0 16px; color: var(--color-text); }

  .input-label {
    display: block;
    font-weight: 600;
    color: var(--color-text);
    margin: 14px 0 6px;
    font-size: 0.95em;
  }

  input[type="text"], textarea, select {
    width: 100%;
    padding: 10px;
    border: 2px solid var(--color-border);
    border-radius: 8px;
    font-family: inherit;
    font-size: 0.95em;
    background: var(--color-surface);
    color: var(--color-text);
  }
  input[type="text"]:focus, textarea:focus, select:focus { outline: none; border-color: var(--color-brand-primary); }

  .char-bar { font-size: 0.85em; color: var(--color-text-muted); margin-top: 4px; }
  .char-bar.warn { color: var(--color-warning); }
  .char-bar.bad { color: var(--color-error); }

  pre {
    background: #1e1e1e;
    color: #d4d4d4;
    padding: 16px;
    border-radius: 8px;
    overflow-x: auto;
    margin: 0;
    font-size: 0.85em;
    line-height: 1.5;
    white-space: pre-wrap;
    word-wrap: break-word;
    min-height: 200px;
  }

  .actions { display: flex; gap: 10px; margin-top: 14px; }
  .btn-primary, .btn-secondary {
    padding: 10px 18px;
    border-radius: 8px;
    border: none;
    cursor: pointer;
    font-weight: 600;
  }
  .btn-primary { background: var(--color-brand-gradient); color: white; }
  .btn-secondary { background: var(--color-surface); border: 2px solid var(--color-brand-primary); color: var(--color-brand-primary); }

  .preview-card {
    background: white;
    border: 1px solid #dadce0;
    border-radius: 8px;
    overflow: hidden;
    margin: 14px 0;
  }
  .preview-label { background: #f0f2f5; padding: 8px 14px; font-size: 0.85em; color: #1c1e21; font-weight: 600; border-bottom: 1px solid #dadce0; }
  .card-img {
    width: 100%;
    aspect-ratio: 1.91 / 1;
    background: #ddd center/cover no-repeat;
  }
  .card-body { padding: 14px; background: #f7f8fa; }
  .card-domain { font-size: 12px; color: #606770; text-transform: uppercase; margin-bottom: 4px; }
  .card-title { font-weight: 600; color: #1c1e21; font-size: 16px; line-height: 1.3; margin-bottom: 4px; }
  .card-desc { font-size: 14px; color: #606770; line-height: 1.4; }
  .card-site { font-size: 13px; color: #606770; font-weight: 600; margin-bottom: 4px; }
  .slack-body { border-left: 4px solid #11998e; background: #f7f8fa; padding-left: 14px; }
  .preview-card.twitter .card-domain { margin-top: 6px; margin-bottom: 0; }

  :global([data-theme="dark"]) .preview-card { background: #15202b; border-color: #38444d; }
  :global([data-theme="dark"]) .preview-label { background: #1c2733; color: #d9d9d9; border-color: #38444d; }
  :global([data-theme="dark"]) .card-body, :global([data-theme="dark"]) .slack-body { background: #15202b; }
  :global([data-theme="dark"]) .card-title { color: #d9d9d9; }
  :global([data-theme="dark"]) .card-desc, :global([data-theme="dark"]) .card-domain, :global([data-theme="dark"]) .card-site { color: #8899a6; }

  .advice { margin-top: 30px; padding: 30px; background: var(--color-surface-elevated); border-radius: 16px; }
  .advice h2 { color: var(--color-text); margin: 0 0 12px; }
  .advice h3 { color: var(--color-brand-primary); margin: 18px 0 8px; }
  .advice p, .advice ul { color: var(--color-text-secondary); line-height: 1.7; }
  .advice ul { padding-left: 24px; }
  .advice a { color: var(--color-link); }

  .level-nav {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    margin-top: 50px;
    padding-top: 30px;
    border-top: 2px solid var(--color-border-light);
  }
  .level-nav .nav-btn {
    padding: 12px 24px;
    background: var(--color-brand-gradient);
    color: white;
    text-decoration: none;
    border-radius: 12px;
    font-weight: 500;
  }

  @media (max-width: 768px) {
    header h1 { font-size: 1.8em; }
    .level-nav { flex-direction: column; }
    .level-nav .nav-btn { width: 100%; text-align: center; }
  }
</style>

<script is:inline>
  (function () {
    const $ = (id) => document.getElementById(id);
    const fields = ['pageTitle', 'pageDesc', 'pageUrl', 'pageImage', 'pageType', 'siteName', 'locale', 'twitterHandle', 'author', 'robots'];
    const out = $('output');

    function escapeHtml(s) {
      return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }

    function generate() {
      const v = {};
      fields.forEach(f => v[f] = $(f).value.trim());

      // Update char count
      const descLen = v.pageDesc.length;
      $('descCount').textContent = descLen;
      const bar = $('descCount').parentElement;
      bar.classList.remove('warn', 'bad');
      if (descLen > 160) bar.classList.add('bad');
      else if (descLen > 155) bar.classList.add('warn');

      let domain = '';
      try { domain = new URL(v.pageUrl).hostname.replace(/^www\./, ''); } catch (e) {}

      const html = `<!-- Primary SEO Meta -->
<title>${escapeHtml(v.pageTitle)}</title>
<meta name="description" content="${escapeHtml(v.pageDesc)}" />
<meta name="author" content="${escapeHtml(v.author)}" />
<meta name="robots" content="${escapeHtml(v.robots)}" />
<link rel="canonical" href="${escapeHtml(v.pageUrl)}" />

<!-- Open Graph (Facebook, LinkedIn, WhatsApp, iMessage, etc.) -->
<meta property="og:title" content="${escapeHtml(v.pageTitle)}" />
<meta property="og:description" content="${escapeHtml(v.pageDesc)}" />
<meta property="og:type" content="${escapeHtml(v.pageType)}" />
<meta property="og:url" content="${escapeHtml(v.pageUrl)}" />
<meta property="og:image" content="${escapeHtml(v.pageImage)}" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="${escapeHtml(v.pageTitle)}" />
<meta property="og:site_name" content="${escapeHtml(v.siteName)}" />
<meta property="og:locale" content="${escapeHtml(v.locale)}" />
${v.pageType === 'article' ? `<meta property="article:author" content="${escapeHtml(v.author)}" />
<meta property="article:published_time" content="${new Date().toISOString().slice(0, 10)}" />` : ''}

<!-- Twitter / X Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content="${escapeHtml(v.pageTitle)}" />
<meta name="twitter:description" content="${escapeHtml(v.pageDesc)}" />
<meta name="twitter:image" content="${escapeHtml(v.pageImage)}" />
<meta name="twitter:image:alt" content="${escapeHtml(v.pageTitle)}" />
${v.twitterHandle ? `<meta name="twitter:creator" content="${escapeHtml(v.twitterHandle)}" />
<meta name="twitter:site" content="${escapeHtml(v.twitterHandle)}" />` : ''}

<!-- Viewport & Theme (UX basics) -->
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="theme-color" content="#667eea" />`;

      out.textContent = html;

      // Live previews
      $('fbTitle').textContent = v.pageTitle;
      $('fbDesc').textContent = v.pageDesc;
      $('fbDomain').textContent = domain.toUpperCase();
      $('fbImg').style.backgroundImage = v.pageImage ? `url(${JSON.stringify(v.pageImage)})` : '';

      $('twTitle').textContent = v.pageTitle;
      $('twDesc').textContent = v.pageDesc;
      $('twDomain').textContent = '🔗 ' + domain;
      $('twImg').style.backgroundImage = v.pageImage ? `url(${JSON.stringify(v.pageImage)})` : '';

      $('slSite').textContent = v.siteName;
      $('slTitle').textContent = v.pageTitle;
      $('slDesc').textContent = v.pageDesc;
    }

    fields.forEach(f => $(f).addEventListener('input', generate));

    $('copyBtn').addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(out.textContent);
        const btn = $('copyBtn');
        btn.textContent = '✓ Copied!';
        setTimeout(() => { btn.textContent = '📋 Copy'; }, 1500);
      } catch (e) { alert('Copy failed. Select all and Ctrl+C.'); }
    });

    $('downloadBtn').addEventListener('click', () => {
      const blob = new Blob([`<!DOCTYPE html>\n<html lang="en">\n<head>\n${out.textContent}\n</head>\n<body></body>\n</html>`], { type: 'text/html' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = 'meta-tags.html';
      a.click();
      URL.revokeObjectURL(url);
    });

    generate();
  })();
</script>
