---
import Layout from '../../layouts/Layout.astro';

const base = import.meta.env.BASE_URL;
---

<Layout title="Title Tag SERP Preview Lab | Waseem's SEO Guide">
  <nav class="breadcrumbs" aria-label="Breadcrumb">
    <ol>
      <li><a href={`${base}/`}>Home</a></li>
      <li><a href={`${base}/labs`}>Labs</a></li>
      <li aria-current="page">Title Tag Tester</li>
    </ol>
  </nav>

  <header>
    <span class="badge">🏷️ LAB 1</span>
    <h1>Title Tag SERP Preview</h1>
    <p class="subtitle">See exactly how Google will render your title tag — including pixel-width truncation, which is how Google actually decides where to cut.</p>
  </header>

  <section class="lab-explainer">
    <div class="info-box">
      <h3>💡 Why pixel width, not character count?</h3>
      <p>SEO blogs say "keep titles under 60 characters" — but that's a shortcut. Google actually truncates titles based on <strong>rendered pixel width</strong> in the SERP, with limits around <strong>600 px on desktop</strong> and <strong>~360 px on mobile</strong>. A title with wide characters (M, W, capital letters) can hit the limit at 50 characters; a title full of i's and l's might fit 70+.</p>
      <p>This tool measures actual pixel width using your browser's canvas API, mimicking how Google renders titles in the Arial-like font it uses in SERPs.</p>
    </div>
  </section>

  <section class="lab-tool">
    <div class="input-section">
      <label for="titleInput" class="input-label">
        Your title tag content:
        <span class="hint">(what would go between <code>&lt;title&gt;</code> tags)</span>
      </label>
      <textarea
        id="titleInput"
        rows="2"
        placeholder="e.g. How to Optimize INP: A 2026 Field Guide | Waseem's SEO Guide"
      >How to Optimize INP: A 2026 Field Guide | Waseem's SEO Guide</textarea>

      <div class="stats-row">
        <div class="stat">
          <span class="stat-label">Characters</span>
          <span class="stat-value" id="charCount">0</span>
          <span class="stat-budget">/ 70 recommended</span>
        </div>
        <div class="stat">
          <span class="stat-label">Pixel width</span>
          <span class="stat-value" id="pixelWidth">0 px</span>
          <span class="stat-budget" id="pixelBudget">/ 600 px desktop</span>
        </div>
        <div class="stat">
          <span class="stat-label">Status</span>
          <span class="stat-value" id="statusBadge">—</span>
        </div>
      </div>

      <label for="urlInput" class="input-label">
        URL (optional — shown in SERP preview):
      </label>
      <input
        type="text"
        id="urlInput"
        placeholder="https://example.com/guide"
        value="https://ward3107.github.io/seo-guide-astro/level2"
      />

      <label for="descInput" class="input-label">
        Meta description (optional):
      </label>
      <textarea
        id="descInput"
        rows="3"
        placeholder="Used for the gray snippet text under the title."
      >INP became a Core Web Vital on March 12, 2024. Here are the 7 optimization techniques that moved 12 production sites from "poor" to "good."</textarea>
    </div>

    <div class="preview-section">
      <h3>📱 Desktop SERP preview</h3>
      <div class="serp-preview desktop">
        <div class="serp-url" id="previewUrlDesktop">https://ward3107.github.io › seo-guide-astro › level2</div>
        <h3 class="serp-title" id="previewTitleDesktop">How to Optimize INP: A 2026 Field Guide | Waseem's SEO Guide</h3>
        <p class="serp-desc" id="previewDescDesktop">INP became a Core Web Vital on March 12, 2024. Here are the 7 optimization techniques that moved 12 production sites from "poor" to "good."</p>
      </div>

      <h3>📱 Mobile SERP preview</h3>
      <div class="serp-preview mobile">
        <div class="serp-url" id="previewUrlMobile">ward3107.github.io › seo-guide-astro</div>
        <h3 class="serp-title" id="previewTitleMobile">How to Optimize INP: A 2026 Field Guide | Waseem's SEO Guide</h3>
        <p class="serp-desc" id="previewDescMobile">INP became a Core Web Vital on March 12, 2024. Here are the 7 optimization techniques that moved 12 production sites from "poor" to "good."</p>
      </div>
    </div>
  </section>

  <section class="advice">
    <h2>🎯 Best practices (with sources)</h2>
    <ul class="advice-list">
      <li><strong>Front-load the primary keyword.</strong> Google weights early words more, and truncation usually clips the end.</li>
      <li><strong>Use a separator + brand at the end.</strong> Pipe (<code>|</code>), hyphen (<code>-</code>), or middle dot (<code>·</code>). Brand last unless your brand IS the keyword (e.g., for a product page).</li>
      <li><strong>Write for humans, then check truncation.</strong> A clipped title with an unclear ending is worse than a slightly shorter, complete one.</li>
      <li><strong>Test in real SERPs.</strong> Google rewrites ~62% of titles. Source: <a href="https://ahrefs.com/blog/google-rewrites-title-tags/" target="_blank" rel="noopener">Ahrefs 2021 study</a>. If your title gets rewritten, your H1 was probably stronger — adjust.</li>
      <li><strong>Don't keyword-stuff.</strong> Google's Helpful Content system explicitly demotes "writing too much content for search engines."</li>
    </ul>
  </section>

  <nav class="level-nav">
    <a href={`${base}/labs`} class="nav-btn">← Back to Labs</a>
    <a href={`${base}/labs/schema-validator`} class="nav-btn">Next: Schema Validator →</a>
  </nav>
</Layout>

<style>
  .breadcrumbs { margin-bottom: 30px; }
  .breadcrumbs ol { display: flex; list-style: none; padding: 0; margin: 0; gap: 8px; flex-wrap: wrap; }
  .breadcrumbs li { color: var(--color-text-muted); }
  .breadcrumbs li:not(:last-child)::after { content: '→'; margin-left: 8px; color: var(--color-text-muted); }
  .breadcrumbs a { color: var(--color-link); text-decoration: none; }

  header { text-align: center; margin-bottom: 40px; }
  .badge {
    display: inline-block;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
    padding: 8px 20px;
    border-radius: 25px;
    font-weight: 600;
    margin-bottom: 20px;
  }
  header h1 { font-size: 2.4em; margin-bottom: 10px; color: var(--color-text); }
  .subtitle { font-size: 1.15em; color: var(--color-text-secondary); max-width: 750px; margin: 0 auto; line-height: 1.6; }

  .info-box {
    background: linear-gradient(135deg, #e3f2fd 0%, #bbdefb 100%);
    border-left: 5px solid #2196f3;
    padding: 24px;
    border-radius: 12px;
    margin: 30px 0;
  }
  .info-box h3 { margin: 0 0 10px; color: #0d47a1; }
  .info-box p { margin: 0 0 10px; color: #0d47a1; line-height: 1.6; }

  .lab-tool {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 30px;
    margin: 40px 0;
  }

  @media (max-width: 900px) {
    .lab-tool { grid-template-columns: 1fr; }
  }

  .input-section, .preview-section {
    background: var(--color-surface-elevated);
    border-radius: 16px;
    padding: 24px;
  }

  .input-label {
    display: block;
    font-weight: 600;
    color: var(--color-text);
    margin: 18px 0 8px;
  }
  .input-label:first-child { margin-top: 0; }
  .hint { font-weight: 400; color: var(--color-text-muted); font-size: 0.9em; }

  textarea, input[type="text"] {
    width: 100%;
    padding: 12px;
    border: 2px solid var(--color-border);
    border-radius: 8px;
    font-family: inherit;
    font-size: 1em;
    background: var(--color-surface);
    color: var(--color-text);
    resize: vertical;
  }
  textarea:focus, input[type="text"]:focus { outline: none; border-color: var(--color-brand-primary); }

  .stats-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
    margin: 18px 0;
  }
  .stat {
    background: var(--color-surface);
    border-radius: 8px;
    padding: 12px;
    text-align: center;
  }
  .stat-label { display: block; font-size: 0.75em; color: var(--color-text-muted); text-transform: uppercase; letter-spacing: 0.5px; }
  .stat-value { display: block; font-size: 1.4em; font-weight: 700; color: var(--color-text); margin: 4px 0; }
  .stat-budget { display: block; font-size: 0.8em; color: var(--color-text-muted); }
  .stat-value.good { color: var(--color-success); }
  .stat-value.warn { color: #f57c00; }
  .stat-value.bad { color: var(--color-error); }

  .preview-section h3 { margin: 0 0 12px; font-size: 1.05em; color: var(--color-text); }
  .preview-section h3:not(:first-child) { margin-top: 28px; }

  .serp-preview {
    background: white;
    border: 1px solid #dadce0;
    border-radius: 8px;
    padding: 16px 20px;
    font-family: arial, sans-serif;
  }
  .serp-preview.mobile { max-width: 360px; padding: 14px 18px; }

  .serp-url {
    font-size: 14px;
    color: #202124;
    margin-bottom: 4px;
  }
  .serp-title {
    font-size: 20px;
    line-height: 26px;
    color: #1a0dab;
    font-weight: 400;
    margin: 0 0 4px;
    cursor: pointer;
  }
  .serp-preview.mobile .serp-title { font-size: 18px; line-height: 24px; }
  .serp-title:hover { text-decoration: underline; }
  .serp-desc {
    font-size: 14px;
    line-height: 22px;
    color: #4d5156;
    margin: 0;
  }

  .advice-list {
    line-height: 1.8;
    color: var(--color-text-secondary);
    padding-left: 24px;
  }
  .advice-list li { margin-bottom: 10px; }

  .level-nav {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    margin-top: 50px;
    padding-top: 30px;
    border-top: 2px solid var(--color-border-light);
  }
  .level-nav .nav-btn {
    padding: 12px 24px;
    background: var(--color-brand-gradient);
    color: white;
    text-decoration: none;
    border-radius: 12px;
    font-weight: 500;
    transition: all 0.3s;
  }

  :global([data-theme="dark"]) .info-box {
    background: linear-gradient(135deg, #0d2238 0%, #16314a 100%);
  }
  :global([data-theme="dark"]) .info-box h3,
  :global([data-theme="dark"]) .info-box p { color: #90caf9; }
  :global([data-theme="dark"]) .serp-preview { background: #202124; border-color: #3c4043; }
  :global([data-theme="dark"]) .serp-url { color: #bdc1c6; }
  :global([data-theme="dark"]) .serp-title { color: #8ab4f8; }
  :global([data-theme="dark"]) .serp-desc { color: #bdc1c6; }

  @media (max-width: 768px) {
    header h1 { font-size: 1.8em; }
    .stats-row { grid-template-columns: 1fr; }
    .level-nav { flex-direction: column; }
    .level-nav .nav-btn { width: 100%; text-align: center; }
  }
</style>

<script is:inline>
  (function () {
    const titleInput = document.getElementById('titleInput');
    const urlInput = document.getElementById('urlInput');
    const descInput = document.getElementById('descInput');

    const charCount = document.getElementById('charCount');
    const pixelWidth = document.getElementById('pixelWidth');
    const pixelBudget = document.getElementById('pixelBudget');
    const statusBadge = document.getElementById('statusBadge');

    const previewTitleDesktop = document.getElementById('previewTitleDesktop');
    const previewUrlDesktop = document.getElementById('previewUrlDesktop');
    const previewDescDesktop = document.getElementById('previewDescDesktop');
    const previewTitleMobile = document.getElementById('previewTitleMobile');
    const previewUrlMobile = document.getElementById('previewUrlMobile');
    const previewDescMobile = document.getElementById('previewDescMobile');

    // Approximate Google's title font using Arial 20px (desktop) — same metric profile
    const canvas = document.createElement('canvas');
    const ctx = canvas.getContext('2d');
    ctx.font = '20px arial, sans-serif';

    const DESKTOP_PX_BUDGET = 600;
    const MOBILE_PX_BUDGET = 360;

    function measure(text) {
      return Math.round(ctx.measureText(text).width);
    }

    function truncateToWidth(text, maxPx) {
      if (measure(text) <= maxPx) return text;
      // Reserve room for an ellipsis
      const ellipsis = '…';
      let lo = 0, hi = text.length;
      while (lo < hi) {
        const mid = Math.floor((lo + hi + 1) / 2);
        const slice = text.slice(0, mid).trimEnd() + ellipsis;
        if (measure(slice) <= maxPx) lo = mid; else hi = mid - 1;
      }
      return text.slice(0, lo).trimEnd() + ellipsis;
    }

    function formatUrlForSerp(url, mobile) {
      try {
        const u = new URL(url);
        const host = u.hostname.replace(/^www\./, '');
        const segments = u.pathname.split('/').filter(Boolean);
        if (mobile) {
          // Mobile shows just host > first segment
          return segments.length ? `${host} › ${segments[0]}` : host;
        }
        return [host, ...segments].join(' › ');
      } catch (e) {
        return url || '';
      }
    }

    function render() {
      const t = titleInput.value || '';
      const u = urlInput.value || '';
      const d = descInput.value || '';

      const px = measure(t);
      const chars = t.length;
      charCount.textContent = chars;
      pixelWidth.textContent = `${px} px`;

      // Status logic
      let status, statusClass;
      if (px === 0) { status = '—'; statusClass = ''; }
      else if (px <= DESKTOP_PX_BUDGET - 60) { status = '✅ Fits'; statusClass = 'good'; }
      else if (px <= DESKTOP_PX_BUDGET) { status = '⚠️ Tight'; statusClass = 'warn'; }
      else { status = '❌ Truncated'; statusClass = 'bad'; }
      statusBadge.textContent = status;
      statusBadge.className = 'stat-value ' + statusClass;

      // Char count color
      charCount.className = 'stat-value';
      if (chars > 70) charCount.classList.add('warn');
      if (chars > 80) charCount.classList.add('bad');

      pixelWidth.className = 'stat-value ' + statusClass;

      // Render previews with actual pixel-based truncation
      previewTitleDesktop.textContent = truncateToWidth(t, DESKTOP_PX_BUDGET);
      previewTitleMobile.textContent = truncateToWidth(t, MOBILE_PX_BUDGET);

      previewUrlDesktop.textContent = formatUrlForSerp(u, false);
      previewUrlMobile.textContent = formatUrlForSerp(u, true);

      previewDescDesktop.textContent = d.length > 160 ? d.slice(0, 158).trimEnd() + '…' : d;
      previewDescMobile.textContent = d.length > 130 ? d.slice(0, 128).trimEnd() + '…' : d;
    }

    titleInput.addEventListener('input', render);
    urlInput.addEventListener('input', render);
    descInput.addEventListener('input', render);
    render();
  })();
</script>
