    function add(line, cls) {
      const div = document.createElement('div');
      div.className = 'result-line ' + cls;
      div.innerHTML = line;
      resultsDiv.appendChild(div);
    }

    function validate() {
      resultsDiv.innerHTML = '';
      richSection.style.display = 'none';
      richEligibility.innerHTML = '';

      const raw = jsonInput.value.trim();
      if (!raw) {
        resultsDiv.innerHTML = '<p class="placeholder">Paste JSON-LD or click a template above to begin.</p>';
        return;
      }

      // Parse
      let data;
      try {
        data = JSON.parse(raw);
      } catch (e) {
        add(`❌ <strong>Invalid JSON syntax:</strong> ${e.message}`, 'error');
        add('💡 Tip: Common issues — trailing commas, unquoted keys, smart quotes pasted from a doc editor.', 'info');
        return;
      }

      add('✅ Valid JSON syntax', 'ok');

      // Handle arrays and single objects
      const items = Array.isArray(data) ? data : (data['@graph'] ? data['@graph'] : [data]);

      items.forEach((item, idx) => {
        const prefix = items.length > 1 ? `[Item ${idx + 1}] ` : '';

        // @context check
        if (!item['@context'] && idx === 0 && !Array.isArray(data) && !data['@graph']) {
          add(`⚠️ ${prefix}Missing <code>@context</code> — should be <code>"https://schema.org"</code>`, 'warn');
        } else if (item['@context'] && !String(item['@context']).includes('schema.org')) {
          add(`⚠️ ${prefix}<code>@context</code> doesn't reference schema.org. Google requires it.`, 'warn');
        } else if (item['@context']) {
          add(`✅ ${prefix}@context: <code>${item['@context']}</code>`, 'ok');
        }

        // @type check
        const type = item['@type'];
        if (!type) {
          add(`❌ ${prefix}Missing <code>@type</code> — required.`, 'error');
          return;
        }
        const typeStr = Array.isArray(type) ? type.join(', ') : type;
        add(`✅ ${prefix}@type: <code>${typeStr}</code>`, 'ok');

        // Required/recommended check
        const typeKey = Array.isArray(type) ? type[0] : type;
        const spec = SCHEMAS[typeKey];
        if (!spec) {
          add(`ℹ️ ${prefix}Type <code>${typeKey}</code> is valid Schema.org but not in this validator's coverage. <a href="https://schema.org/${typeKey}" target="_blank" rel="noopener">View schema.org docs</a>`, 'info');
          return;
        }

        // Required
        const missingRequired = spec.required.filter(field => !(field in item) || item[field] === '' || item[field] == null);
        if (missingRequired.length === 0) {
          add(`✅ ${prefix}All ${spec.required.length} required field(s) present: <code>${spec.required.join(', ')}</code>`, 'ok');
        } else {
          missingRequired.forEach(f => {
            add(`❌ ${prefix}Missing <strong>required</strong> field: <code>${f}</code>`, 'error');
          });
        }

        // Recommended
        const missingRecommended = spec.recommended.filter(field => !(field in item) || item[field] === '' || item[field] == null);
        if (missingRecommended.length === 0 && spec.recommended.length > 0) {
          add(`✅ ${prefix}All recommended fields present`, 'ok');
        } else {
          missingRecommended.forEach(f => {
            add(`⚠️ ${prefix}Missing <em>recommended</em> field: <code>${f}</code>`, 'warn');
          });
        }

        // Rich-result eligibility
        if (missingRequired.length === 0) {
          const card = document.createElement('div');
          card.className = 'rich-eligibility-card';
          card.innerHTML = `<strong>🎯 ${typeKey}:</strong> ${spec.rich}<br><a href="${spec.sourceUrl}" target="_blank" rel="noopener" style="font-size:0.9em">📘 Google docs for ${typeKey}</a>`;
          richEligibility.appendChild(card);
          richSection.style.display = 'block';
        }
      });

      // Common issues
      if (raw.includes('"@type":')) {
        // OK
      }
      if (raw.includes(',]') || raw.includes(',}')) {
        add('⚠️ Detected trailing comma — may cause issues in strict parsers (works in this tool but fails some).', 'warn');
      }
    }

    jsonInput.addEventListener('input', validate);

    // Preset buttons
    document.querySelectorAll('[data-preset]').forEach(btn => {
      btn.addEventListener('click', () => {
        const key = btn.getAttribute('data-preset');
        jsonInput.value = JSON.stringify(PRESETS[key], null, 2);
        validate();
      });
    });

    // Actions
    $('copyBtn').addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(jsonInput.value);
        const btn = $('copyBtn');
        const orig = btn.textContent;
        btn.textContent = '✓ Copied!';
        setTimeout(() => { btn.textContent = orig; }, 1500);
      } catch (e) {
        alert('Copy failed. Select all and Ctrl+C.');
      }
    });
    $('clearBtn').addEventListener('click', () => {
      jsonInput.value = '';
      validate();
    });

    // Start with Article preset loaded
    jsonInput.value = JSON.stringify(PRESETS.article, null, 2);
    validate();
  })();
</script>
