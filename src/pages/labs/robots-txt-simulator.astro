---
import Layout from '../../layouts/Layout.astro';

const base = import.meta.env.BASE_URL;
---

<Layout title="robots.txt Simulator Lab | Waseem's SEO Guide">
  <nav class="breadcrumbs" aria-label="Breadcrumb">
    <ol>
      <li><a href={`${base}/`}>Home</a></li>
      <li><a href={`${base}/labs`}>Labs</a></li>
      <li aria-current="page">robots.txt Simulator</li>
    </ol>
  </nav>

  <header>
    <span class="badge">🛡️ LAB 3</span>
    <h1>robots.txt Simulator</h1>
    <p class="subtitle">Paste a robots.txt and a URL. Get the exact decision Googlebot would make — based on the official Google parsing rules (RFC 9309 + Google extensions).</p>
  </header>

  <section class="presets">
    <h3>📋 Try a real-world robots.txt:</h3>
    <div class="preset-row">
      <button data-preset="basic" type="button">Basic (allow all)</button>
      <button data-preset="strict" type="button">Block admin</button>
      <button data-preset="wildcard" type="button">Wildcards (*/?)</button>
      <button data-preset="multi-agent" type="button">Multi-agent</button>
      <button data-preset="real-world" type="button">Real (e-commerce)</button>
    </div>
  </section>

  <section class="lab-tool">
    <div class="left-pane">
      <label for="robotsInput" class="input-label">
        Your <code>robots.txt</code> content:
      </label>
      <textarea
        id="robotsInput"
        rows="14"
        spellcheck="false"
        placeholder="User-agent: *&#10;Disallow:"
      >User-agent: *
Allow: /
Disallow: /admin/
Disallow: /private/
Disallow: /*.pdf$
Disallow: /search?
Allow: /search?category=

User-agent: Googlebot-Image
Disallow: /images/private/

Sitemap: https://example.com/sitemap.xml</textarea>

      <label for="urlInput" class="input-label">
        Test URL (path or full URL):
      </label>
      <input
        type="text"
        id="urlInput"
        placeholder="/about or https://example.com/about"
        value="/admin/dashboard"
      />

      <label for="agentSelect" class="input-label">
        User-agent:
      </label>
      <select id="agentSelect">
        <option value="Googlebot">Googlebot (web)</option>
        <option value="Googlebot-Image">Googlebot-Image</option>
        <option value="Googlebot-News">Googlebot-News</option>
        <option value="Googlebot-Video">Googlebot-Video</option>
        <option value="GPTBot">GPTBot (OpenAI)</option>
        <option value="ClaudeBot">ClaudeBot (Anthropic)</option>
        <option value="PerplexityBot">PerplexityBot</option>
        <option value="Bingbot">Bingbot</option>
        <option value="*">Other (uses * rules)</option>
      </select>

      <div class="actions">
        <button id="testBtn" type="button" class="btn-primary">▶ Test crawlability</button>
      </div>
    </div>

    <div class="right-pane">
      <h3>🎯 Result</h3>
      <div id="result">
        <p class="placeholder">Enter a URL and click "Test crawlability."</p>
      </div>

      <h4 class="batch-h">📋 Batch test multiple URLs (one per line):</h4>
      <textarea id="batchInput" rows="8" placeholder="/&#10;/about&#10;/admin/&#10;/search?q=test"
>/
/about
/admin/dashboard
/search?q=test
/search?category=shoes
/private/users.csv
/files/report.pdf</textarea>
      <button id="batchBtn" type="button" class="btn-secondary">▶ Test all URLs</button>
      <div id="batchResult"></div>
    </div>
  </section>

  <section class="explainer">
    <h2>🧠 How Googlebot parses robots.txt</h2>
    <ol>
      <li>
        <strong>Most specific rule wins.</strong> If <code>Allow: /admin/api/</code> and <code>Disallow: /admin/</code> both match, the longer path (more specific) takes priority.
      </li>
      <li>
        <strong>If allow + disallow are equally specific</strong>, <code>Allow</code> wins. (Google's rule; differs from the original 1994 spec.)
      </li>
      <li>
        <strong>Wildcards:</strong>
        <ul>
          <li><code>*</code> matches any sequence of characters within a path segment context.</li>
          <li><code>$</code> at the end of a pattern anchors it to end of URL: <code>Disallow: /*.pdf$</code> blocks <code>.pdf</code> files.</li>
        </ul>
      </li>
      <li>
        <strong>Case-sensitive paths.</strong> <code>/Admin/</code> and <code>/admin/</code> are different rules.
      </li>
      <li>
        <strong>User-agent matching:</strong> Most-specific agent block wins. A block for <code>Googlebot</code> overrides <code>*</code> for Googlebot.
      </li>
      <li>
        <strong>Crawl-delay is ignored by Googlebot.</strong> Use Search Console crawl-rate settings instead. Other bots may honor it.
      </li>
      <li>
        <strong>Blocked ≠ deindexed.</strong> A page blocked by robots.txt can still be indexed (with no description) if it has external links. To deindex, allow the crawl AND use <code>&lt;meta name="robots" content="noindex"&gt;</code>.
      </li>
    </ol>
    <p class="source"><strong>Source:</strong> <a href="https://developers.google.com/search/docs/crawling-indexing/robots/robots_txt" target="_blank" rel="noopener">Google Search Central — robots.txt specifications</a></p>
  </section>

  <nav class="level-nav">
    <a href={`${base}/labs/schema-validator`} class="nav-btn">← Schema Validator</a>
    <a href={`${base}/labs/meta-tag-generator`} class="nav-btn">Next: Meta Tag Generator →</a>
  </nav>
</Layout>

<style>
  .breadcrumbs { margin-bottom: 30px; }
  .breadcrumbs ol { display: flex; list-style: none; padding: 0; margin: 0; gap: 8px; flex-wrap: wrap; }
  .breadcrumbs li { color: var(--color-text-muted); }
  .breadcrumbs li:not(:last-child)::after { content: '→'; margin-left: 8px; color: var(--color-text-muted); }
  .breadcrumbs a { color: var(--color-link); text-decoration: none; }

  header { text-align: center; margin-bottom: 40px; }
  .badge {
    display: inline-block;
    background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
    color: white;
    padding: 8px 20px;
    border-radius: 25px;
    font-weight: 600;
    margin-bottom: 20px;
  }
  header h1 { font-size: 2.4em; margin-bottom: 10px; color: var(--color-text); }
  .subtitle { font-size: 1.15em; color: var(--color-text-secondary); max-width: 750px; margin: 0 auto; line-height: 1.6; }

  .presets { margin: 30px 0; }
  .preset-row { display: flex; flex-wrap: wrap; gap: 10px; }
  .preset-row button {
    padding: 8px 16px;
    background: var(--color-surface-elevated);
    border: 2px solid var(--color-border);
    border-radius: 20px;
    color: var(--color-text);
    cursor: pointer;
    font-size: 0.95em;
  }
  .preset-row button:hover {
    background: #4facfe;
    color: white;
    border-color: #4facfe;
  }

  .lab-tool {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 30px;
    margin: 30px 0;
  }
  @media (max-width: 900px) { .lab-tool { grid-template-columns: 1fr; } }

  .left-pane, .right-pane {
    background: var(--color-surface-elevated);
    border-radius: 16px;
    padding: 24px;
  }

  .input-label {
    display: block;
    font-weight: 600;
    color: var(--color-text);
    margin: 16px 0 8px;
  }
  .input-label:first-child { margin-top: 0; }

  textarea, input[type="text"], select {
    width: 100%;
    padding: 12px;
    border: 2px solid var(--color-border);
    border-radius: 8px;
    font-family: 'Monaco', 'Consolas', monospace;
    font-size: 0.95em;
    background: var(--color-surface);
    color: var(--color-text);
  }
  select { font-family: inherit; }

  .actions { margin-top: 16px; }
  .btn-primary, .btn-secondary {
    padding: 10px 20px;
    border-radius: 8px;
    border: none;
    cursor: pointer;
    font-weight: 600;
    transition: all 0.2s;
  }
  .btn-primary { background: var(--color-brand-gradient); color: white; }
  .btn-primary:hover { transform: translateY(-2px); box-shadow: var(--shadow-md); }
  .btn-secondary { background: var(--color-surface); border: 2px solid var(--color-brand-primary); color: var(--color-brand-primary); margin-top: 10px; }
  .btn-secondary:hover { background: var(--color-brand-primary); color: white; }

  .right-pane h3, .right-pane h4 { margin: 0 0 12px; color: var(--color-text); }
  .batch-h { margin-top: 24px; }
  .placeholder { color: var(--color-text-muted); font-style: italic; }

  .verdict {
    padding: 18px;
    border-radius: 12px;
    margin-bottom: 12px;
  }
  .verdict.allow { background: rgba(40, 167, 69, 0.15); border-left: 4px solid var(--color-success); }
  .verdict.deny { background: rgba(220, 53, 69, 0.15); border-left: 4px solid var(--color-error); }
  .verdict-title { font-weight: 700; font-size: 1.1em; margin-bottom: 6px; }
  .verdict.allow .verdict-title { color: var(--color-success); }
  .verdict.deny .verdict-title { color: var(--color-error); }
  .verdict-detail { color: var(--color-text-secondary); font-size: 0.95em; line-height: 1.5; }
  .verdict-rule { font-family: monospace; background: rgba(0,0,0,0.06); padding: 4px 8px; border-radius: 4px; display: inline-block; margin-top: 6px; }
  :global([data-theme="dark"]) .verdict-rule { background: rgba(255,255,255,0.08); }

  .batch-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 10px 14px;
    margin: 6px 0;
    border-radius: 8px;
    font-family: monospace;
    font-size: 0.9em;
  }
  .batch-row.allow { background: rgba(40, 167, 69, 0.1); color: var(--color-success); }
  .batch-row.deny { background: rgba(220, 53, 69, 0.1); color: var(--color-error); }

  .explainer { margin-top: 40px; padding: 30px; background: var(--color-surface-elevated); border-radius: 16px; }
  .explainer h2 { color: var(--color-text); margin: 0 0 16px; }
  .explainer ol { padding-left: 24px; color: var(--color-text-secondary); line-height: 1.8; }
  .explainer ol > li { margin-bottom: 14px; }
  .explainer ul { padding-left: 22px; margin-top: 4px; }
  .explainer code { background: var(--color-surface); padding: 2px 6px; border-radius: 4px; color: var(--color-brand-primary); }
  .explainer .source { margin-top: 16px; font-size: 0.9em; color: var(--color-text-muted); }
  .explainer a { color: var(--color-link); }

  .level-nav {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    margin-top: 50px;
    padding-top: 30px;
    border-top: 2px solid var(--color-border-light);
  }
  .level-nav .nav-btn {
    padding: 12px 24px;
    background: var(--color-brand-gradient);
    color: white;
    text-decoration: none;
    border-radius: 12px;
    font-weight: 500;
  }

  @media (max-width: 768px) {
    header h1 { font-size: 1.8em; }
    .level-nav { flex-direction: column; }
    .level-nav .nav-btn { width: 100%; text-align: center; }
  }
</style>

<script is:inline>
  (function () {
    const $ = (id) => document.getElementById(id);
    const robotsInput = $('robotsInput');
    const urlInput = $('urlInput');
    const agentSelect = $('agentSelect');
    const resultDiv = $('result');
    const batchInput = $('batchInput');
    const batchResult = $('batchResult');

    const PRESETS = {
      basic: `# Allow everything
User-agent: *
Allow: /`,
      strict: `User-agent: *
Disallow: /admin/
Disallow: /api/
Disallow: /private/
Allow: /`,
      wildcard: `User-agent: *
Disallow: /*.pdf$
Disallow: /search?
Allow: /search?category=
Disallow: /*?sort=
Disallow: /*?utm_`,
      'multi-agent': `User-agent: *
Allow: /

User-agent: Googlebot
Disallow: /staging/

User-agent: Googlebot-Image
Disallow: /images/private/

User-agent: GPTBot
Disallow: /

User-agent: ClaudeBot
Disallow: /

Sitemap: https://example.com/sitemap.xml`,
      'real-world': `User-agent: *
Disallow: /cart
Disallow: /checkout
Disallow: /account/
Disallow: /search
Disallow: /*?sort=
Disallow: /*?filter=
Disallow: /*?utm_
Disallow: /*.json$
Disallow: /api/
Allow: /api/products/
Allow: /

User-agent: Googlebot-Image
Disallow: /products/*/reviews

Sitemap: https://example.com/sitemap.xml
Sitemap: https://example.com/sitemap-products.xml`
    };

    // Parse robots.txt into agent → rules
    function parse(text) {
      const lines = text.split('\n');
      const blocks = {}; // agent -> { allow: [], disallow: [] }
      let current = [];

      lines.forEach(rawLine => {
        let line = rawLine.replace(/#.*$/, '').trim();
        if (!line) return;
        const match = line.match(/^([^:]+):\s*(.*)$/);
        if (!match) return;
        const key = match[1].trim().toLowerCase();
        const value = match[2].trim();

        if (key === 'user-agent') {
          // Start of a new block (or same block if preceded by user-agent lines)
          if (!blocks[value]) blocks[value] = { allow: [], disallow: [] };
          // Reset current to point to this new agent's rules
          current = [blocks[value]];
        } else if (key === 'allow') {
          if (current.length === 0) return;
          current.forEach(b => b.allow.push(value));
        } else if (key === 'disallow') {
          if (current.length === 0) return;
          if (value === '') return; // Empty Disallow = allow all
          current.forEach(b => b.disallow.push(value));
        }
        // sitemap, host, crawl-delay etc. ignored for matching
      });

      return blocks;
    }

    // Convert robots.txt pattern to regex
    function patternToRegex(pattern) {
      // Escape regex metacharacters except * and $ at end
      let endAnchor = false;
      if (pattern.endsWith('$')) {
        endAnchor = true;
        pattern = pattern.slice(0, -1);
      }
      const escaped = pattern.replace(/[.+^=!:${}()|[\]\\]/g, '\\$&');
      const regexStr = escaped.replace(/\*/g, '.*');
      return new RegExp('^' + regexStr + (endAnchor ? '$' : ''));
    }

    function matchLength(pattern, path) {
      const re = patternToRegex(pattern);
      const m = path.match(re);
      return m ? pattern.length : -1;
    }

    function getAgentBlock(blocks, agent) {
      // Most specific user-agent wins; case-insensitive
      const keys = Object.keys(blocks);
      const lower = agent.toLowerCase();
      let best = null;
      keys.forEach(k => {
        if (k.toLowerCase() === lower) best = k;
      });
      if (best) return blocks[best];
      // Partial match: e.g., Googlebot-Image will fall back to Googlebot? Per spec, no — only exact match falls back to *.
      // Fall back to *
      return blocks['*'] || { allow: [], disallow: [] };
    }

    function decide(robotsTxt, url, agent) {
      const blocks = parse(robotsTxt);
      const block = getAgentBlock(blocks, agent);

      // Extract path from URL
      let path = url;
      try {
        if (url.includes('://')) path = new URL(url).pathname + new URL(url).search;
      } catch (e) { /* keep as-is */ }
      if (!path.startsWith('/')) path = '/' + path;

      let bestAllow = -1, bestDisallow = -1;
      let bestAllowRule = '', bestDisallowRule = '';

      block.allow.forEach(rule => {
        const len = matchLength(rule, path);
        if (len > bestAllow) { bestAllow = len; bestAllowRule = rule; }
      });
      block.disallow.forEach(rule => {
        const len = matchLength(rule, path);
        if (len > bestDisallow) { bestDisallow = len; bestDisallowRule = rule; }
      });

      let verdict, rule, why;
      if (bestDisallow === -1 && bestAllow === -1) {
        verdict = 'allow';
        rule = '(no matching rule — default allow)';
        why = `No rule in the <code>${agent}</code> block (or fallback <code>*</code> block) matches this path.`;
      } else if (bestDisallow === -1) {
        verdict = 'allow';
        rule = 'Allow: ' + bestAllowRule;
        why = `An <code>Allow</code> rule matched. No <code>Disallow</code> rule applies.`;
      } else if (bestAllow === -1) {
        verdict = 'deny';
        rule = 'Disallow: ' + bestDisallowRule;
        why = `A <code>Disallow</code> rule matched. No <code>Allow</code> rule overrides it.`;
      } else if (bestAllow >= bestDisallow) {
        verdict = 'allow';
        rule = `Allow: ${bestAllowRule} (longer/equal to Disallow: ${bestDisallowRule})`;
        why = `When Allow and Disallow are equally specific, Google's parser prefers <code>Allow</code>.`;
      } else {
        verdict = 'deny';
        rule = `Disallow: ${bestDisallowRule} (longer than Allow: ${bestAllowRule})`;
        why = `The <code>Disallow</code> rule is more specific (longer match) and wins.`;
      }

      return { verdict, rule, why, path, agent };
    }

    function test() {
      const robots = robotsInput.value;
      const url = urlInput.value;
      const agent = agentSelect.value;

      const { verdict, rule, why, path } = decide(robots, url, agent);
      const icon = verdict === 'allow' ? '✅' : '❌';
      const label = verdict === 'allow' ? 'ALLOWED' : 'BLOCKED';

      resultDiv.innerHTML = `
        <div class="verdict ${verdict}">
          <div class="verdict-title">${icon} ${label}</div>
          <div class="verdict-detail">
            <strong>User-agent:</strong> <code>${agent}</code><br>
            <strong>Path tested:</strong> <code>${path}</code><br>
            ${why}
            <div class="verdict-rule">${rule}</div>
          </div>
        </div>
      `;
    }

    function testBatch() {
      const robots = robotsInput.value;
      const agent = agentSelect.value;
      const urls = batchInput.value.split('\n').map(u => u.trim()).filter(Boolean);

      batchResult.innerHTML = '';
      urls.forEach(u => {
        const { verdict, rule } = decide(robots, u, agent);
        const icon = verdict === 'allow' ? '✅' : '❌';
        const row = document.createElement('div');
        row.className = 'batch-row ' + verdict;
        row.innerHTML = `<span>${icon} ${u}</span><span style="opacity:0.7">${rule}</span>`;
        batchResult.appendChild(row);
      });
    }

    $('testBtn').addEventListener('click', test);
    $('batchBtn').addEventListener('click', testBatch);

    document.querySelectorAll('[data-preset]').forEach(btn => {
      btn.addEventListener('click', () => {
        robotsInput.value = PRESETS[btn.getAttribute('data-preset')];
        test();
      });
    });

    // Test on load
    test();
  })();
</script>
