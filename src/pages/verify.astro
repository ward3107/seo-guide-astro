---
import Layout from '../layouts/Layout.astro';

const base = import.meta.env.BASE_URL;
---

<Layout title="Verify Certificate | Waseem's SEO Guide">
  <nav class="breadcrumbs" aria-label="Breadcrumb">
    <ol>
      <li><a href={`${base}/`}>Home</a></li>
      <li aria-current="page">Verify Certificate</li>
    </ol>
  </nav>

  <header>
    <span class="badge">🔍 VERIFY</span>
    <h1>Verify a Certificate</h1>
    <p class="subtitle">Confirm whether a Course Completion certificate is legitimate.</p>
  </header>

  <section id="verifyResult" class="verify-result">
    <p class="placeholder">Loading…</p>
  </section>

  <section class="how">
    <h2>How verification works</h2>
    <p>Each certificate issued by this course has a deterministic 16-character verification ID derived from the student's name and the completion date using SHA-256. When you visit a verification URL, this page recomputes the ID from the URL parameters and compares — if they match, the certificate is valid.</p>
    <p>This means the verification works <strong>without any server</strong>: no database, no API, no privacy concerns. The full check happens in your browser.</p>
    <p><strong>To verify manually:</strong> enter the name + completion date from the certificate below.</p>

    <div class="manual-verify">
      <label for="manualName">Name on certificate</label>
      <input type="text" id="manualName" placeholder="e.g. Jane Doe" />
      <label for="manualDate">Completion date (YYYY-MM-DD)</label>
      <input type="date" id="manualDate" />
      <label for="manualId">Verification ID (16 hex chars)</label>
      <input type="text" id="manualId" placeholder="e.g. 1A2B3C4D5E6F7890" maxlength="16" />
      <button id="manualVerifyBtn" type="button">Verify manually</button>
    </div>
  </section>

  <nav class="level-nav">
    <a href={`${base}/`} class="nav-btn">🏠 Back to Home</a>
  </nav>
</Layout>

<style>
  .breadcrumbs { margin-bottom: 30px; }
  .breadcrumbs ol { display: flex; list-style: none; padding: 0; margin: 0; gap: 8px; flex-wrap: wrap; }
  .breadcrumbs li { color: var(--color-text-muted); }
  .breadcrumbs li:not(:last-child)::after { content: '→'; margin-left: 8px; color: var(--color-text-muted); }
  .breadcrumbs a { color: var(--color-link); text-decoration: none; }

  header { text-align: center; margin-bottom: 40px; }
  .badge {
    display: inline-block;
    background: linear-gradient(135deg, #11998e 0%, #38ef7d 100%);
    color: white;
    padding: 8px 20px;
    border-radius: 25px;
    font-weight: 600;
    margin-bottom: 20px;
  }
  header h1 { font-size: 2.5em; margin-bottom: 10px; color: var(--color-text); }
  .subtitle { font-size: 1.15em; color: var(--color-text-secondary); }

  .verify-result {
    padding: 40px;
    border-radius: 18px;
    margin-bottom: 40px;
  }
  .verify-result.valid {
    background: linear-gradient(135deg, #d4edda 0%, #c3e6cb 100%);
    border-left: 6px solid var(--color-success);
  }
  .verify-result.invalid {
    background: linear-gradient(135deg, #f8d7da 0%, #f5c6cb 100%);
    border-left: 6px solid var(--color-error);
  }
  .verify-result.idle {
    background: var(--color-surface-elevated);
  }

  .verify-result h2 { margin: 0 0 10px; }
  .verify-result.valid h2 { color: #155724; }
  .verify-result.invalid h2 { color: #721c24; }
  .verify-result p { line-height: 1.7; margin: 6px 0; }
  .verify-result.valid p { color: #155724; }
  .verify-result.invalid p { color: #721c24; }

  .cert-details {
    background: rgba(255,255,255,0.5);
    padding: 16px;
    border-radius: 10px;
    margin-top: 14px;
  }
  .cert-details dl { display: grid; grid-template-columns: max-content 1fr; gap: 6px 16px; margin: 0; }
  .cert-details dt { font-weight: 600; }

  .placeholder { color: var(--color-text-muted); font-style: italic; }

  .how { margin: 40px 0; padding: 30px; background: var(--color-surface-elevated); border-radius: 14px; }
  .how h2 { color: var(--color-text); margin: 0 0 16px; }
  .how p { color: var(--color-text-secondary); line-height: 1.7; }

  .manual-verify {
    margin-top: 24px;
    display: grid;
    gap: 8px;
  }
  .manual-verify label { font-weight: 600; color: var(--color-text); }
  .manual-verify input {
    padding: 10px 12px;
    border: 2px solid var(--color-border);
    border-radius: 8px;
    background: var(--color-surface);
    color: var(--color-text);
    font-size: 1em;
  }
  .manual-verify button {
    margin-top: 6px;
    padding: 12px;
    background: var(--color-brand-gradient);
    color: white;
    border: none;
    border-radius: 8px;
    cursor: pointer;
    font-weight: 600;
  }

  :global([data-theme="dark"]) .verify-result.valid {
    background: linear-gradient(135deg, #1f3a2a 0%, #2a4a3a 100%);
  }
  :global([data-theme="dark"]) .verify-result.valid h2,
  :global([data-theme="dark"]) .verify-result.valid p { color: #c8e6c9; }
  :global([data-theme="dark"]) .verify-result.invalid {
    background: linear-gradient(135deg, #3a1a1a 0%, #4a2a2a 100%);
  }
  :global([data-theme="dark"]) .verify-result.invalid h2,
  :global([data-theme="dark"]) .verify-result.invalid p { color: #ffcdd2; }
  :global([data-theme="dark"]) .cert-details { background: rgba(0,0,0,0.2); }

  .level-nav {
    display: flex;
    justify-content: center;
    gap: 20px;
    margin-top: 50px;
    padding-top: 30px;
    border-top: 2px solid var(--color-border-light);
  }
  .level-nav .nav-btn {
    padding: 12px 24px;
    background: var(--color-brand-gradient);
    color: white;
    text-decoration: none;
    border-radius: 12px;
    font-weight: 500;
  }
</style>

<script is:inline>
  (function () {
    async function makeVerifyId(name, dateISO) {
      const payload = `seo-geo-course|${name.toLowerCase().trim()}|${dateISO}|completed`;
      const buf = new TextEncoder().encode(payload);
      const hashBuf = await crypto.subtle.digest('SHA-256', buf);
      const bytes = Array.from(new Uint8Array(hashBuf));
      const hex = bytes.map(b => b.toString(16).padStart(2, '0')).join('');
      return hex.slice(0, 16).toUpperCase();
    }

    function formatDate(iso) {
      try {
        return new Date(iso + 'T00:00:00').toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
      } catch (e) { return iso; }
    }

    async function verify(name, date, id) {
      const result = document.getElementById('verifyResult');
      if (!name || !date || !id) {
        result.className = 'verify-result idle';
        result.innerHTML = '<h2>Enter or paste a verification URL</h2><p>This page accepts URL parameters in the form <code>?name=...&amp;date=YYYY-MM-DD&amp;id=...</code>, or use the manual form below.</p>';
        return;
      }

      const expected = await makeVerifyId(name, date);
      const submittedId = String(id).toUpperCase();

      if (expected === submittedId) {
        result.className = 'verify-result valid';
        result.innerHTML = `
          <h2>✅ Certificate verified</h2>
          <p>This certificate is authentic — the verification ID matches the deterministic hash of the name + completion date.</p>
          <div class="cert-details">
            <dl>
              <dt>Issued to:</dt><dd>${escapeHtml(name)}</dd>
              <dt>Completion date:</dt><dd>${escapeHtml(formatDate(date))}</dd>
              <dt>Course:</dt><dd>SEO &amp; GEO Mastery — 4 Levels</dd>
              <dt>Verification ID:</dt><dd><code>${escapeHtml(submittedId)}</code></dd>
              <dt>Instructor:</dt><dd>Waseem</dd>
            </dl>
          </div>
        `;
      } else {
        result.className = 'verify-result invalid';
        result.innerHTML = `
          <h2>❌ Certificate could not be verified</h2>
          <p>The verification ID in the URL doesn't match the deterministic hash for the given name + date.</p>
          <p><strong>Possible causes:</strong></p>
          <ul>
            <li>The URL was tampered with or mistyped.</li>
            <li>The certificate was generated outside this course.</li>
            <li>The name has a slightly different spelling or whitespace.</li>
          </ul>
          <p style="margin-top:14px"><strong>Expected ID for "${escapeHtml(name)}" + ${escapeHtml(date)}:</strong> <code>${escapeHtml(expected)}</code></p>
          <p><strong>Submitted ID:</strong> <code>${escapeHtml(submittedId)}</code></p>
        `;
      }
    }

    function escapeHtml(s) {
      return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }

    // Auto-verify from URL params
    const params = new URLSearchParams(window.location.search);
    const name = params.get('name');
    const date = params.get('date');
    const id = params.get('id');
    verify(name, date, id);

    // Manual verify
    document.getElementById('manualVerifyBtn').addEventListener('click', () => {
      const n = document.getElementById('manualName').value;
      const d = document.getElementById('manualDate').value;
      const i = document.getElementById('manualId').value;
      verify(n, d, i);
    });

    // Prefill manual fields if URL params present
    if (name) document.getElementById('manualName').value = name;
    if (date) document.getElementById('manualDate').value = date;
    if (id) document.getElementById('manualId').value = id;
  })();
</script>
