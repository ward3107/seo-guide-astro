  .question label::before {
    content: attr(data-letter);
    background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
    color: white;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    display: flex;
    align-items: center;
